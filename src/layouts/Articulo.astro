---
import "katex/dist/katex.min.css";
import Base from "./Base.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import { sitio, waAgendar } from "../data/sitio";

export interface Frontmatter {
  title: string;
  description?: string;
  tags: string[];
  date: string;
  read: string;
  videoUrl?: string;
}

interface Props {
  frontmatter: Frontmatter;
}

const { title, description, tags, date, read, videoUrl } =
  Astro.props.frontmatter;
---

<Base
  title={`${title} · ${sitio.nombre}`}
  description={description}
  navVariante="simple"
>
  <article>
    <header>
      <div class="tags">
        {tags.map((t) => <span>{t}</span>)}
      </div>
      <h1>{title}</h1>
      <div class="meta">
        <span>Por {sitio.autora}</span><span>·</span><span>{date}</span><span
          >·</span
        ><span>{read}</span>
      </div>
    </header>

    {
      videoUrl && (
        <div class="video">
          <VideoEmbed url={videoUrl} title={title} />
          <p class="pie">
            Mira el ejercicio en video y, si quieres el detalle completo, sigue
            la explicación escrita — va aún más paso a paso.
          </p>
        </div>
      )
    }

    <div class="cuerpo">
      <slot />
    </div>

    <aside class="cta">
      <div>
        <h3>¿Te quedó alguna duda?</h3>
        <p>Agenda una clase y lo resolvemos juntos.</p>
      </div>
      <a
        class="btn btn-primario"
        href={waAgendar}
        target="_blank"
        rel="noopener"
      >
        Agendar por WhatsApp
      </a>
    </aside>
  </article>
</Base>

<style is:global>
  /* El HTML del cuerpo lo genera Markdown, así que no lleva los hashes del scope. */
  .cuerpo {
    font-size: 1.08rem;
    line-height: 1.75;
    color: #2f3350;
  }

  .cuerpo > p {
    margin: 0 0 24px;
  }

  .cuerpo h2 {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--tinta);
    margin: 36px 0 14px;
  }

  .cuerpo h3 {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--tinta);
    margin: 28px 0 12px;
  }

  .cuerpo ul,
  .cuerpo ol {
    margin: 0 0 24px;
    padding-left: 1.4em;
  }

  .cuerpo blockquote {
    margin: 0 0 32px;
    background: var(--papel);
    border: 1px solid var(--arena);
    border-left: 4px solid var(--violeta);
    border-radius: 16px;
    padding: 24px 28px;
    box-shadow: 0 8px 24px rgba(27, 31, 59, 0.05);
    color: var(--tinta);
  }

  .cuerpo blockquote > :last-child {
    margin-bottom: 0;
  }

  /* Caja de solución: <div class="solucion"> dentro del Markdown. */
  .cuerpo .solucion {
    background: var(--tinta);
    color: var(--papel);
    border-radius: 16px;
    padding: 24px 28px;
    margin: 0 0 32px;
    font-size: 1.15rem;
  }

  .cuerpo .solucion > :last-child {
    margin-bottom: 0;
  }

  .cuerpo .etiqueta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    color: var(--violeta);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 12px;
  }

  .cuerpo .solucion .etiqueta {
    color: var(--lila);
  }

  .cuerpo .katex {
    font-size: 1.08em;
  }

  .cuerpo .katex-display {
    margin: 0;
    padding: 2px 0;
    overflow-x: auto;
    overflow-y: hidden;
  }
</style>

<style>
  article {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 56px) var(--gutter) 80px;
  }

  header {
    margin-bottom: 40px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }

  .tags span {
    padding: 5px 12px;
    background: var(--lila-fondo);
    color: var(--violeta-osc);
    font-size: 13px;
    font-weight: 600;
    border-radius: 999px;
  }

  h1 {
    margin: 0 0 18px;
    font-family: var(--serif);
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    color: var(--tinta);
    text-wrap: balance;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    color: var(--violeta);
    font-size: 14px;
    font-weight: 500;
  }

  .video {
    margin: 0 0 44px;
  }

  .pie {
    margin: 18px auto 0;
    max-width: 52ch;
    text-align: center;
    color: var(--violeta);
    font-size: 14px;
  }

  .cta {
    margin: 48px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    background: var(--papel);
    border: 1px solid var(--arena);
    border-radius: 20px;
    padding: 28px 32px;
    box-shadow: var(--sombra-card);
  }

  .cta h3 {
    margin: 0 0 4px;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--tinta);
  }

  .cta p {
    margin: 0;
    color: #5a5e78;
    font-size: 15px;
  }

  .cta .btn {
    padding: 13px 26px;
    white-space: nowrap;
  }
</style>
