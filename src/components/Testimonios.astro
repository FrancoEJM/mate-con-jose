---
import { getCollection } from 'astro:content';

const testimonios = (await getCollection('testimonios')).map((t) => t.data);
---

<section class="banda">
  <div class="interior">
    <h2 data-reveal>Lo que dicen mis estudiantes</h2>
    <div class="carrusel-wrap">
      <button type="button" class="flecha-carrusel flecha-prev" data-flecha="prev" aria-label="Ver testimonios anteriores">‹</button>
      <button type="button" class="flecha-carrusel flecha-next" data-flecha="next" aria-label="Ver más testimonios">›</button>
      <div class="carrusel" data-auto-scroll>
      {
        testimonios.map((t) => (
          <figure>
            <div class="estrellas" aria-label="5 de 5 estrellas">
              ★★★★★
            </div>
            <blockquote>«{t.texto}»</blockquote>
            <figcaption>
              {t.nombre} <span>· {t.detalle}</span>
            </figcaption>
          </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  section {
    margin-top: 24px;
  }

  .interior {
    max-width: var(--ancho);
    margin: 0 auto;
    padding: clamp(40px, 6vw, 64px) 0;
  }

  h2 {
    text-align: center;
    margin: 0 0 32px;
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    color: var(--tinta);
  }

  .carrusel {
    gap: 20px;
    padding: 8px var(--gutter) 20px;
  }

  /* Las flechas se alinean con el contenido, no con el borde de la banda.
     El max() evita que en móvil, con el gutter chico, se salgan de la pantalla. */
  .carrusel-wrap :global(.flecha-prev) {
    left: max(2px, calc(var(--gutter) - 22px));
  }

  .carrusel-wrap :global(.flecha-next) {
    right: max(2px, calc(var(--gutter) - 22px));
  }

  figure {
    margin: 0;
    flex: 0 0 min(340px, 82vw);
    scroll-snap-align: center;
    background: var(--crema);
    border: 1px solid var(--arena);
    border-radius: 18px;
    padding: clamp(20px, 5vw, 28px);
  }

  .estrellas {
    color: var(--violeta);
    font-size: 20px;
    margin-bottom: 10px;
    letter-spacing: 2px;
  }

  blockquote {
    margin: 0 0 18px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--texto);
  }

  figcaption {
    font-weight: 600;
    color: var(--tinta);
  }

  figcaption span {
    color: var(--violeta);
    font-weight: 500;
  }
</style>
