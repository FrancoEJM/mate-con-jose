---
import { sitio, waAgendar } from "../data/sitio";

const insignias = [
  "2 años enseñando",
  "PAES · Universidad",
  "Online y presencial",
];
---

<section id="inicio">
  <div class="grid">
    <div class="texto" data-reveal>
      <h1>
        Matemática que <span>de verdad</span> se entiende.
      </h1>
      <p class="intro">
        ¡Hola! Soy {sitio.autora}, estudiante de Licenciatura en Ciencias con
        mención en Matemáticas en la UACh, me encantan las matemáticas y además
        disfruto muchísimo de enseñarlas.
      </p>

      <div class="insignias">
        {
          insignias.map((i) => (
            <span>
              <span class="asterisco" aria-hidden="true">
                ✦
              </span>
              {i}
            </span>
          ))
        }
      </div>

      <div class="acciones">
        <a
          class="btn btn-primario"
          href={waAgendar}
          target="_blank"
          rel="noopener"
        >
          Agendar por WhatsApp →
        </a>
        <a class="btn btn-borde" href="#servicios">Ver servicios</a>
      </div>
    </div>

    <div class="retrato" data-reveal>
      <div class="marco">
        <div class="anillo" aria-hidden="true"></div>
        <img
          src="/img/sitio/logo.png"
          alt="Logo de Mate con Jose: matemáticas para PAES y universidad"
          width="420"
          height="420"
        />
      </div>
    </div>
  </div>
</section>

<style>
  section {
    max-width: var(--ancho);
    margin: 0 auto;
    padding: clamp(28px, 6vw, 84px) var(--gutter) clamp(24px, 4vw, 48px);
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    justify-content: center;
  }

  .texto {
    flex: 1 1 440px;
    min-width: min(100%, 380px);
  }

  h1 {
    margin: 0 0 20px;
    font-family: var(--serif);
    font-weight: 800;
    font-size: clamp(2.4rem, 5.5vw, 3.9rem);
    line-height: 1.06;
    color: var(--tinta);
    text-wrap: balance;
  }

  h1 span {
    color: var(--violeta);
    font-style: italic;
  }

  .intro {
    margin: 0 0 28px;
    font-size: clamp(1.08rem, 1.6vw, 1.22rem);
    line-height: 1.65;
    color: var(--texto);
    max-width: 56ch;
  }

  .intro strong {
    color: var(--tinta);
  }

  .insignias {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 32px;
  }

  .insignias > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--papel);
    border: 1px solid var(--arena);
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    color: var(--tinta);
  }

  .asterisco {
    color: var(--violeta);
    font-size: 16px;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .retrato {
    flex: 0 1 360px;
    min-width: min(100%, 280px);
    display: flex;
    justify-content: center;
  }

  .marco {
    position: relative;
    width: min(420px, 80vw);
  }

  .anillo {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 2px solid var(--lila);
    opacity: 0.55;
  }

  .marco img {
    position: relative;
    width: 100%;
    height: auto;
    border-radius: 50%;
    box-shadow: 0 24px 60px rgba(27, 31, 59, 0.16);
  }

  /* En móvil el logo ya está en la barra superior: repetirlo solo alarga el scroll. */
  @media (max-width: 860px) {
    .retrato {
      display: none;
    }
  }
</style>
