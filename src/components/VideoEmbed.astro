---
interface Props {
  url: string;
  title?: string;
}

const { url, title = 'Ver video' } = Astro.props;

/**
 * Solo se incrustan publicaciones de Instagram: son las únicas que muestran preview
 * dentro de la página. Se conserva el tipo del link (/p/ o /reel/) porque el embed
 * responde en la misma ruta con la que se compartió.
 */
const m = url.match(/instagram\.com\/(reel|reels|p|tv)\/([\w-]+)/);
const tipo = m?.[1] === 'reels' ? 'reel' : m?.[1];
const id = m?.[2];
---

<div class="embed">
  {
    id ? (
      <div class="marco">
        <iframe
          src={`https://www.instagram.com/${tipo}/${id}/embed/`}
          title={title}
          loading="lazy"
          scrolling="no"
          allow="autoplay; encrypted-media; picture-in-picture"
          allowfullscreen
        />
      </div>
    ) : (
      <a class="tarjeta" href={url || '#'} target="_blank" rel="noopener">
        <span class="simbolos" aria-hidden="true">
          <span>f(x)</span>
          <span>∑</span>
          <span>√x</span>
        </span>
        <span class="centro">
          <span class="play" aria-hidden="true">
            ▶
          </span>
          <span class="titulo">{title}</span>
          <span class="pill">Ver el video ↗</span>
        </span>
      </a>
    )
  }
</div>

<style>
  .embed {
    width: 100%;
    max-width: 340px;
    margin: 0 auto;
  }

  .marco {
    position: relative;
    width: 100%;
    height: 640px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--papel);
    border: 1px solid var(--arena);
    box-shadow: 0 10px 30px rgba(27, 31, 59, 0.12);
  }

  .marco iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Si el link no es un reel de Instagram, se muestra esta tarjeta que lleva al original. */
  .tarjeta {
    position: relative;
    display: block;
    width: 100%;
    padding-top: 170%;
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(160deg, var(--tinta), var(--violeta-osc));
    box-shadow: 0 10px 30px rgba(27, 31, 59, 0.18);
    text-decoration: none;
  }

  .simbolos {
    position: absolute;
    inset: 0;
    opacity: 0.14;
    font-family: var(--serif);
    color: var(--papel);
  }

  .simbolos span {
    position: absolute;
  }

  .simbolos span:nth-child(1) {
    top: 10%;
    left: 12%;
    font-size: 34px;
    font-style: italic;
  }

  .simbolos span:nth-child(2) {
    bottom: 14%;
    right: 14%;
    font-size: 40px;
  }

  .simbolos span:nth-child(3) {
    top: 44%;
    left: 60%;
    font-size: 30px;
    font-style: italic;
  }

  .centro {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    color: var(--papel);
    text-align: center;
    padding: 24px;
  }

  .play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(253, 251, 247, 0.16);
    border: 2px solid rgba(253, 251, 247, 0.5);
    font-size: 24px;
    padding-left: 4px;
  }

  .titulo {
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.04em;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    background: var(--papel);
    color: var(--tinta);
    font-weight: 700;
    font-size: 13px;
    border-radius: 999px;
  }
</style>
